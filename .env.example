# Crabjar Environment Variables
# Copy this file to .env and customize for your deployment.
# All variables are required - there are no fallback defaults.

# State directory for rate limiting and temporary state files
CRABJAR_STATE_DIR=/tmp/crabjar-state

# Path to JEV decision criteria specs (relative path from repo root is acceptable)
STRUCTURED_AUX_CRITERIA_PATH=crabjar-structured-aux/specs/criteria

# Training data directory for unsloth MCP server
CRABJAR_TRAINING_DATA_DIR=/home/crombo/training-data-dump

# Unsloth Studio outputs directory
UNSLOTH_OUTPUTS_DIR=~/.unsloth/studio/outputs

# SSH bastion host key path
CRABJAR_BASTION_KEY_PATH=/home/crombo/.ssh/id_bastion

# SSH lab machine key path
CRABJAR_SSH_KEY_PATH=/home/crombo/.ssh/id_lab